aws_region       = "af-south-1"
name             = "voicesecure-staging"
redis_auth_token = "supply-through-TF_VAR-not-source-control"

# Cost-bearing managed data services are opt-in for staging.
enable_msk                       = false
enable_rds                       = false
enable_redis                     = false
rds_multi_az                     = false
rds_deletion_protection          = false
rds_performance_insights_enabled = false
redis_node_count                 = 1
redis_multi_az                   = false
audit_object_lock_enabled        = false
log_retention_days               = 30
interface_endpoint_services      = []

# Low-cost single-host application delivery.
application_instance_type       = "t3.micro"
application_public_subnet_cidr  = "10.45.30.0/24"
application_ingress_cidrs       = ["0.0.0.0/0"]
application_root_volume_size_gb = 8
# application_ami_id            = "ami-0123456789abcdef0"
