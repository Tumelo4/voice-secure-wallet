{
  "name": "@voicesecure/mobile",
  "private": true,
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm test",
    "test": "npm run test:unit && npm run test:screen",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.ts",
    "test:screen": "jest --runInBand"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "expo": "57.0.9",
    "expo-audio": "~57.0.2",
    "expo-file-system": "~57.0.1",
    "expo-secure-store": "57.0.0",
    "expo-status-bar": "57.0.0",
    "nativewind": "4.2.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "0.21.2",
    "react-redux": "9.3.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "jest": "30.4.2",
    "jest-expo": "57.0.3",
    "react-native-worklets": "0.11.3",
    "tailwindcss": "4.3.3",
    "test-renderer": "^1.2.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "glob": "11.1.0",
    "minimatch": "10.2.6",
    "postcss": "8.5.25",
    "test-exclude": "8.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test-screen/**/*.test.tsx"
    ]
  }
}
